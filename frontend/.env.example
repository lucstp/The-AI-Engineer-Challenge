# ─────────────────────────────────────────────────────────────────────
# Frontend environment variables.
#
# This file is a template — committed to git, contains NO real values.
# To set up local dev, copy this file to `.env.local` (gitignored) and
# fill in the values. In Vercel, set the same vars via the dashboard.
#
#   cp .env.example .env.local
#   # then edit .env.local
#
# Or one-liner to generate SESSION_SECRET into a new .env.local:
#   printf 'SESSION_SECRET=%s\n' "$(openssl rand -base64 48)" > .env.local
#
# Authoritative schema: frontend/lib/env.ts
# ─────────────────────────────────────────────────────────────────────

# REQUIRED in production. Server-side secret that AES-256-GCM-encrypts
# the user's OpenAI API key before it lands in the session cookie.
# Generate with:
#   openssl rand -base64 48
# Validation rules (enforced at boot in lib/env.ts):
#   - Dev/test: >= 32 characters
#   - Production: >= 48 characters AND >= 3 bits/char Shannon entropy
#     (so you can't ship "aaaaaaaaaaaa..." to prod)
SESSION_SECRET=

# OPTIONAL. Model name passed to OpenAI's chat completions endpoint.
# Default (code): "gpt-4.1-mini" — course-canonical for the AI Maker
# Space — AI Engineering Challenge course ("Accessing 'gpt-4.1-mini'
# (ChatGPT) like a developer"). Fast (TTFT <1s, ~3-5s total), no
# reasoning overhead, comfortable with the 1500-token default budget.
#
# The sibling FastAPI backend (api/index.py) intentionally diverges to
# gpt-5 for reasoning depth on that surface — the frontend takes the
# course-canonical fast path so a grader sees first tokens immediately.
# Set OPENAI_MODEL=gpt-5 here if you want symmetry, or pick one of the
# alternatives below.
#
# Speed vs. depth trade-off:
#   - gpt-4.1-mini  — DEFAULT, course canonical, fast (TTFT <1s, ~3-5s total)
#   - gpt-4o        — balanced quality + speed
#   - gpt-4o-mini   — fastest, cheapest, fine for factual Q&A
#   - gpt-5         — reasoning model, deep but slow (5-30s wait before
#                     tokens stream); bump OPENAI_MAX_COMPLETION_TOKENS to 4000
OPENAI_MODEL=

# OPTIONAL. max_completion_tokens passed to OpenAI.
# Default (code): 1500 — comfortable for the gpt-4.1-mini default
# (no reasoning overhead). If you override OPENAI_MODEL to a reasoning
# model (gpt-5, o-series), bump this to 4000: those models burn hundreds
# of tokens on internal chain-of-thought BEFORE emitting visible content,
# and a budget too low results in an empty stream and the user-facing
# error "The assistant returned an empty response." Recommended values:
#   - gpt-4.1-mini / gpt-4o / gpt-4o-mini:  1500  (default is plenty)
#   - gpt-5 / reasoning:                    4000  (room for reasoning + answer)
OPENAI_MAX_COMPLETION_TOKENS=

# OPTIONAL. Upstash REST URL for /api/chat sliding-window rate limiting.
# When BOTH KV_REST_API_URL and KV_REST_API_TOKEN are set, the chat
# route enforces 20 req/min/IP via Upstash Redis (state shared across
# function instances). Absence triggers the per-instance in-memory
# fallback with a loud production warning — safe for single-instance
# dev, NOT safe for autoscaled serverless.
#
# Easiest setup: Vercel dashboard → Storage → Marketplace → Upstash
# (sets these auto-named variables for you, no custom prefix).
KV_REST_API_URL=

# OPTIONAL. Pair with KV_REST_API_URL above. Same Upstash integration
# sets this auto-named variable.
KV_REST_API_TOKEN=

# OPTIONAL. Public URL of the Pond5 "Aerophonia" track on Vercel Blob.
# Format: https://[storeId].public.blob.vercel-storage.com/aerophonia-full-[hash].mp3
# When set, /api/audio/aerophonia proxy-streams from the CDN. When
# absent, the route falls back to a local file at
# `private/audio/aerophonia-full.mp3` (development only).
# The route allow-lists the host suffix `.public.blob.vercel-storage.com`
# so a tampered env var cannot redirect the fetch elsewhere.
# Upload once with:
#   pnpm vercel blob put private/audio/aerophonia-full.mp3 --add-random-suffix
BLOB_AUDIO_AEROPHONIA_URL=

# ─────────────────────────────────────────────────────────────────────
# Sentry — error sink + source-map upload
# ─────────────────────────────────────────────────────────────────────
# All four vars are AUTO-INJECTED on deployed environments by the
# Vercel Marketplace Sentry integration once "Connect Project" is
# clicked in the marketplace install flow. They are listed here only
# for documentation — do NOT set them locally unless you specifically
# want local-dev exceptions to ship to your Sentry project (you
# usually don't — it burns the free Developer-tier event quota on
# noise). The SDK initializes in no-op mode when `NEXT_PUBLIC_SENTRY_DSN`
# is absent, which is the desired local default.

# Browser + server SDKs both read this. Not secret — DSNs are
# public-ish webhook URLs.
# Format: https://<key>@o<orgId>.ingest.<region>.sentry.io/<projectId>
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only. Required for source-map upload (so production
# stack traces show real file:line instead of minified bundle hash).
# Vercel injects this as a secret on every build.
SENTRY_AUTH_TOKEN=

# Build-time only. Sentry org + project slugs — used by withSentryConfig
# in next.config.ts to scope the source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=
