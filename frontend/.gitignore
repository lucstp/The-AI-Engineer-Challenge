# Override the repo-root rule that ignores any `lib/` (Python dist dirs):
# the frontend's source `lib/` must be tracked.
!/lib/

# Node / pnpm
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/

# TypeScript incremental build info
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.DS_Store
.vscode/
.idea/

# Env files
.env
.env.*
!.env.example
